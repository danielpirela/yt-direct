{
  "name": "yt-direct",
  "version": "1.0.0",
  "description": "YouTube Direct URL Extractor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild:mac": "bash prebuild.sh mac",
    "prebuild:win": "bash prebuild.sh win",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "npm run build:mac && npm run build:win"
  },
  "build": {
    "appId": "com.snickerland.yt-direct",
    "productName": "YT Direct URL",
    "files": ["main.js", "preload.js", "renderer.html"],
    "extraResources": [
      { "from": "bin/yt-dlp", "to": "yt-dlp" },
      { "from": "bin/yt-dlp.exe", "to": "yt-dlp.exe" }
    ],
    "mac": { "target": "dmg", "identity": null, "icon": "icon.png" },
    "win": { "target": "portable", "icon": "icon.png" }
  },
  "author": "Snickerland",
  "license": "ISC",
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
